// Regression: compound-assignment on a watch_mapping()'d mapping element.
//
// Two bugs in src/packages/ops/ops.cc + the VM error unwind:
//
//  1. f_xor_eq/f_lsh_eq/f_rsh_eq/f_mod_eq checked sp->u.lvalue->type against
//     T_NUMBER BEFORE resolving the T_LVALUE_MAPPING_WATCHED sentinel that
//     m[k] yields on a watched mapping -- so `m[k] ^= v` (and <<= >>= %=)
//     threw a spurious "Bad left type" on EVERY watched use.  (^= etc. are
//     fixed to resolve the sentinel first, like f_and_eq/f_or_eq already do.)
//
//  2. A watched m[k] arms the shared global_lvalue_mapping_watched scratch in
//     push_indexed_lvalue; the consuming opcode resets it on success but an
//     error() thrown in between (e.g. a bad rhs type) skipped the reset,
//     leaving a dangling map pointer + leaked key ref that corrupted (and
//     could crash) the next watched operation.  restore_context() now clears
//     the armed state on every error unwind.
//
// Both paths threw / misbehaved on the unfixed binary.

int fires;

void cb(mixed keys, mixed oldv, mixed newv) {
  fires++;
}

void do_tests() {
  mapping m = ([ "b": 1, "t": 8, "s": 0 ]);
  watch_mapping(m, (: cb :));

  // Bug 1: these four must NOT throw and must compute correctly.
  fires = 0;
  m["b"] ^= 3;             ASSERT_EQ(2, m["b"]);   // 1 ^ 3
  m["t"] <<= 1;            ASSERT_EQ(16, m["t"]);  // 8 << 1
  m["t"] >>= 2;            ASSERT_EQ(4, m["t"]);   // 16 >> 2
  m["t"] %= 3;             ASSERT_EQ(1, m["t"]);   // 4 % 3
  // The other compound ops on watched elements too, for good measure.
  m["b"] += 5;             ASSERT_EQ(7, m["b"]);
  m["b"] -= 1;             ASSERT_EQ(6, m["b"]);
  m["b"] *= 2;             ASSERT_EQ(12, m["b"]);
  m["b"] |= 1;             ASSERT_EQ(13, m["b"]);
  m["b"] &= 6;             ASSERT_EQ(4, m["b"]);
  m["b"]++;                ASSERT_EQ(5, m["b"]);
  m["b"]--;                ASSERT_EQ(4, m["b"]);
  m["s"] ||= 7;            ASSERT_EQ(7, m["s"]);   // 0 was falsy
  m["s"] &&= 3;            ASSERT_EQ(3, m["s"]);   // 7 was truthy
  m["s"] ??= 9;            ASSERT_EQ(3, m["s"]);   // 3 is defined
  // Every op above except the ??= (value already defined) fires the watch.
  ASSERT_EQ(13, fires);

  // Bug 2: a watched compound op that legitimately errors (bad rhs type)
  // must not leave the shared watch state armed. Arm on "b", throw, then do
  // a clean watched compound op on "t" and confirm exactly one fire and the
  // right stored value -- stale armed state would double-fire, misreport, or
  // crash (a dangling map/key ref from the aborted op).
  // m["t"] is 1 here (from the %= above).
  mixed err = catch(m["b"] ^= "not a number");
  ASSERT(err != 0);
  fires = 0;
  m["t"] ^= 12;                 // 1 ^ 12 == 13; clean watched compound op
  ASSERT_EQ(13, m["t"]);
  ASSERT_EQ(1, fires);          // exactly one fire, on "t" only

  unwatch_mapping(m, (: cb :));
}
